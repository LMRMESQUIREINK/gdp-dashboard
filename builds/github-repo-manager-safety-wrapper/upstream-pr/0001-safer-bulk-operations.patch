new file mode 100644
index 0000000..d0ac05a
--- /dev/null
+++ b/safety-core.js
@@ -0,0 +1,227 @@
+"use strict";
+
+const fs = require("fs");
+const readline = require("readline");
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/**
+ * Reads a plain-text repo-list file the same way the original
+ * github-repo-manager scripts do: one name per line, blanks stripped.
+ * Returns raw lines — use parseEntries() to resolve them against an
+ * owner.
+ */
+function loadRepoList(filePath) {
+  if (!fs.existsSync(filePath)) return null;
+  return fs
+    .readFileSync(filePath, "utf-8")
+    .split("\n")
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0);
+}
+
+/**
+ * Resolves raw list-file lines into {owner, repo, display} entries.
+ *
+ * The original scripts hardcode a single owner (GITHUB_USER or
+ * TARGET_ORG) for every line in every list file — the README names
+ * this explicitly as unsupported ("owner/repository values are not
+ * supported"). With ownerRepoMode on, a line containing a "/" is
+ * parsed as an explicit owner/repo pair (for managing repos across
+ * more than one account/org from one list file); a bare line still
+ * falls back to defaultOwner either way, so existing single-owner list
+ * files keep working unchanged.
+ */
+function parseEntries(rawLines, defaultOwner, ownerRepoMode) {
+  return rawLines.map((line) => {
+    if (ownerRepoMode && line.includes("/")) {
+      const slash = line.indexOf("/");
+      const owner = line.slice(0, slash).trim();
+      const repo = line.slice(slash + 1).trim();
+      if (owner && repo) {
+        return { owner, repo, display: `${owner}/${repo}` };
+      }
+    }
+    return {
+      owner: defaultOwner,
+      repo: line,
+      display: ownerRepoMode ? `${defaultOwner}/${line}` : line,
+    };
+  });
+}
+
+/**
+ * Guards against the failure mode the real repo's README doesn't name:
+ * a target list accidentally containing every name that was ever
+ * written to all_repos.txt — the natural result of a copy-paste
+ * workflow across two unrelated files. If the target entries exactly
+ * match the full inventory, that is far more likely to be a mistake
+ * than an intentional "act on everything" request, so it's refused
+ * unless the caller explicitly opts in with allowFullMatch.
+ *
+ * all_repos.txt (written by the original 1-fetch-repos.js) only ever
+ * lists one owner's repos, so its entries are always normalized against
+ * defaultOwner here — a cross-owner target list can only match it if
+ * every entry actually resolves to defaultOwner.
+ */
+function checkFullWipeGuard(entries, allReposFile, defaultOwner, allowFullMatch) {
+  const allRepos = loadRepoList(allReposFile);
+  if (!allRepos || allRepos.length === 0) return { blocked: false };
+
+  const allSet = new Set(allRepos.map((r) => `${defaultOwner}/${r}`.toLowerCase()));
+  const targetSet = new Set(entries.map((e) => `${e.owner}/${e.repo}`.toLowerCase()));
+
+  const isFullMatch =
+    targetSet.size === allSet.size && [...targetSet].every((key) => allSet.has(key));
+
+  if (isFullMatch && !allowFullMatch) {
+    return {
+      blocked: true,
+      reason:
+        `The target list exactly matches all ${allRepos.length} repositories ` +
+        `owned by ${defaultOwner}. This is refused by default because it is the ` +
+        `signature of an accidental full-inventory copy-paste, not an ` +
+        `intentional request to act on every repository you own. Re-run ` +
+        `with --force-full if that really is what you want.`,
+    };
+  }
+  return { blocked: false };
+}
+
+/**
+ * Prompts on stdin for an exact confirmation phrase. Injectable for
+ * tests via the `prompt` option — production code never has to touch
+ * this directly.
+ */
+function realPrompt(question) {
+  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
+  return new Promise((resolve) => {
+    rl.question(question, (answer) => {
+      rl.close();
+      resolve(answer);
+    });
+  });
+}
+
+const RETRYABLE_PATTERN = /secondary rate limit|rate limit exceeded|ETIMEDOUT|ECONNRESET|socket hang up/i;
+
+function isRetryable(error) {
+  const status = error && error.status;
+  if (typeof status === "number" && status >= 500) return true;
+  const message = (error && error.message) || "";
+  return RETRYABLE_PATTERN.test(message);
+}
+
+/**
+ * Calls fn(), retrying with exponential backoff only on errors that
+ * look transient (5xx, secondary rate limit, network resets). A 404
+ * or other definitive 4xx fails immediately instead of burning retries
+ * on something that will never succeed.
+ */
+async function withRetry(fn, { attempts = 3, baseDelayMs = 500, sleepFn = sleep } = {}) {
+  let lastError;
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return await fn();
+    } catch (error) {
+      lastError = error;
+      if (!isRetryable(error) || attempt === attempts) throw error;
+      await sleepFn(baseDelayMs * 2 ** (attempt - 1));
+    }
+  }
+  throw lastError;
+}
+
+/**
+ * The shared safety envelope every *-safe.js entry point runs its
+ * per-repo operation through: full-wipe guard, dry-run, typed
+ * confirmation for destructive operations, retry-with-backoff per
+ * repo, continue-on-error across the list (same as the original
+ * scripts), and a real summary at the end (the originals print nothing
+ * comparable).
+ *
+ * @param {object} opts
+ * @param {string} opts.operationName - e.g. "DELETE", "TRANSFER"
+ * @param {{owner:string, repo:string, display:string}[]} opts.entries - target entries
+ * @param {string} [opts.allReposFile] - inventory file for the full-wipe guard
+ * @param {string} [opts.defaultOwner] - owner all_repos.txt's entries belong to
+ * @param {boolean} [opts.allowFullMatch] - bypass the full-wipe guard
+ * @param {boolean} [opts.dryRun] - list intended actions without calling execute
+ * @param {boolean} [opts.destructive] - require typed confirmation before proceeding
+ * @param {function(number): string} [opts.confirmPhrase] - given entries.length, the exact phrase to require
+ * @param {function({owner,repo,display}): Promise<any>} opts.execute - performs the real operation for one entry
+ * @param {function(string): Promise<string>} [opts.prompt] - injectable for tests
+ * @param {function} [opts.sleepFn] - injectable for tests
+ */
+async function runSafely(opts) {
+  const {
+    operationName,
+    entries,
+    allReposFile,
+    defaultOwner,
+    allowFullMatch = false,
+    dryRun = false,
+    destructive = false,
+    confirmPhrase,
+    execute,
+    prompt = realPrompt,
+    sleepFn = sleep,
+    log = console.log,
+  } = opts;
+
+  if (allReposFile) {
+    const guard = checkFullWipeGuard(entries, allReposFile, defaultOwner, allowFullMatch);
+    if (guard.blocked) {
+      log(`❌ ${guard.reason}`);
+      return { aborted: "full-wipe-guard", succeeded: [], failed: [], skipped: [] };
+    }
+  }
+
+  if (dryRun) {
+    entries.forEach((entry) => log(`[DRY RUN] Would ${operationName} ${entry.display}`));
+    return { aborted: null, dryRun: true, succeeded: [], failed: [], skipped: [...entries] };
+  }
+
+  if (destructive) {
+    const phrase = confirmPhrase ? confirmPhrase(entries.length) : `${operationName} ${entries.length}`;
+    const answer = await prompt(
+      `⚠️  Type "${phrase}" to confirm ${operationName} on ${entries.length} repositories: `
+    );
+    if (answer.trim() !== phrase) {
+      log("❌ Confirmation did not match. Aborting without making any changes.");
+      return { aborted: "confirmation-mismatch", succeeded: [], failed: [], skipped: [] };
+    }
+  }
+
+  const succeeded = [];
+  const failed = [];
+
+  for (const entry of entries) {
+    try {
+      log(`Processing: ${entry.display}...`);
+      await withRetry(() => execute(entry), { sleepFn });
+      log(`  ✅ ${operationName} succeeded for ${entry.display}`);
+      succeeded.push(entry.display);
+    } catch (error) {
+      log(`  ❌ ${operationName} failed for ${entry.display}: ${error.message}`);
+      failed.push({ repo: entry.display, error: error.message });
+    }
+  }
+
+  log(
+    `\n${operationName} complete: ${succeeded.length} succeeded, ${failed.length} failed, ` +
+      `out of ${entries.length} total.`
+  );
+
+  return { aborted: null, succeeded, failed, skipped: [] };
+}
+
+module.exports = {
+  loadRepoList,
+  parseEntries,
+  checkFullWipeGuard,
+  withRetry,
+  isRetryable,
+  runSafely,
+  realPrompt,
+};
diff --git a/test-safety-core.js b/test-safety-core.js
new file mode 100644
index 0000000..a1fbe83
--- /dev/null
+++ b/test-safety-core.js
@@ -0,0 +1,269 @@
+"use strict";
+
+const fs = require("fs");
+const path = require("path");
+const os = require("os");
+
+const { parseEntries, checkFullWipeGuard, withRetry, runSafely } = require("./safety-core");
+
+let passed = 0;
+let failed = 0;
+
+function assert(cond, msg) {
+  if (cond) {
+    passed++;
+    console.log(`OK: ${msg}`);
+  } else {
+    failed++;
+    console.error(`FAIL: ${msg}`);
+  }
+}
+
+async function assertRejects(fn, msg) {
+  try {
+    await fn();
+    failed++;
+    console.error(`FAIL: ${msg} (expected rejection, got none)`);
+  } catch (e) {
+    passed++;
+    console.log(`OK: ${msg}`);
+  }
+}
+
+// --- test fixtures -----------------------------------------------------
+
+const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "repo-manager-safety-test-"));
+const allReposFile = path.join(tmpDir, "all_repos.txt");
+fs.writeFileSync(allReposFile, ["alpha", "beta", "gamma"].join("\n"));
+
+const noopSleep = () => Promise.resolve();
+const fakeLog = (sink) => (msg) => sink.push(msg);
+
+function entries(names, defaultOwner = "me") {
+  return parseEntries(names, defaultOwner, false);
+}
+
+// --- parseEntries ----------------------------------------------------------
+
+(function testParseEntriesBareMode() {
+  const result = parseEntries(["alpha", "beta"], "me", false);
+  assert(
+    result.every((e) => e.owner === "me" && e.display === e.repo),
+    "bare mode: every entry defaults to the given owner, display is the bare repo name"
+  );
+})();
+
+(function testParseEntriesOwnerRepoMode() {
+  const result = parseEntries(["me/alpha", "someorg/beta", "gamma"], "me", true);
+  assert(result[0].owner === "me" && result[0].repo === "alpha" && result[0].display === "me/alpha", "owner-repo mode parses an explicit owner/repo line");
+  assert(result[1].owner === "someorg" && result[1].repo === "beta", "owner-repo mode parses a different, non-default owner");
+  assert(result[2].owner === "me" && result[2].repo === "gamma" && result[2].display === "me/gamma", "owner-repo mode still accepts a bare line, defaulting the owner and showing it in display");
+})();
+
+// --- checkFullWipeGuard ------------------------------------------------
+
+(function testFullWipeGuard() {
+  const fullMatch = checkFullWipeGuard(entries(["gamma", "alpha", "beta"]), allReposFile, "me", false);
+  assert(fullMatch.blocked === true, "full-wipe guard blocks when target entries exactly match all_repos.txt (order-independent)");
+
+  const fullMatchAllowed = checkFullWipeGuard(entries(["gamma", "alpha", "beta"]), allReposFile, "me", true);
+  assert(fullMatchAllowed.blocked === false, "full-wipe guard allows the same list through with allowFullMatch");
+
+  const partial = checkFullWipeGuard(entries(["alpha"]), allReposFile, "me", false);
+  assert(partial.blocked === false, "full-wipe guard does not block a genuine subset");
+
+  const missingInventory = checkFullWipeGuard(entries(["alpha"]), path.join(tmpDir, "does-not-exist.txt"), "me", false);
+  assert(missingInventory.blocked === false, "full-wipe guard no-ops gracefully when no inventory file exists");
+})();
+
+(function testFullWipeGuardOwnerRepoMode() {
+  // All three entries resolve to the default owner's full inventory,
+  // just spelled out as owner/repo — the guard must still catch this.
+  const sameOwnerSpelledOut = parseEntries(["me/alpha", "me/beta", "me/gamma"], "me", true);
+  const blocked = checkFullWipeGuard(sameOwnerSpelledOut, allReposFile, "me", false);
+  assert(blocked.blocked === true, "owner-repo mode: explicit 'defaultOwner/name' entries matching the full inventory still trip the guard");
+
+  // A cross-owner list can never equal a single-owner inventory file.
+  const crossOwner = parseEntries(["me/alpha", "someorg/beta", "me/gamma"], "me", true);
+  const notBlocked = checkFullWipeGuard(crossOwner, allReposFile, "me", false);
+  assert(notBlocked.blocked === false, "owner-repo mode: a cross-owner target list is never mistaken for a single-owner full wipe");
+})();
+
+// --- withRetry -----------------------------------------------------------
+
+(async function testRetry() {
+  let calls = 0;
+  const result = await withRetry(
+    async () => {
+      calls++;
+      if (calls < 3) throw new Error("secondary rate limit hit, please retry");
+      return "ok";
+    },
+    { attempts: 5, baseDelayMs: 1, sleepFn: noopSleep }
+  );
+  assert(result === "ok" && calls === 3, `retryable error retries until success (got ${calls} calls, result=${result})`);
+
+  let non404calls = 0;
+  await assertRejects(
+    () =>
+      withRetry(
+        async () => {
+          non404calls++;
+          const err = new Error("Not Found");
+          err.status = 404;
+          throw err;
+        },
+        { attempts: 5, baseDelayMs: 1, sleepFn: noopSleep }
+      ),
+    "non-retryable error (404) rejects"
+  );
+  assert(non404calls === 1, `non-retryable error fails fast without burning retries (got ${non404calls} calls)`);
+
+  let exhausted = 0;
+  await assertRejects(
+    () =>
+      withRetry(
+        async () => {
+          exhausted++;
+          throw new Error("ETIMEDOUT");
+        },
+        { attempts: 3, baseDelayMs: 1, sleepFn: noopSleep }
+      ),
+    "retryable error still rejects once attempts are exhausted"
+  );
+  assert(exhausted === 3, `exhausts exactly the configured attempt count (got ${exhausted})`);
+})();
+
+// --- runSafely: dry-run ---------------------------------------------------
+
+(async function testDryRun() {
+  const log = [];
+  let executeCalls = 0;
+  const result = await runSafely({
+    operationName: "DELETE",
+    entries: entries(["alpha"]),
+    allReposFile,
+    defaultOwner: "me",
+    dryRun: true,
+    destructive: true,
+    execute: async () => {
+      executeCalls++;
+    },
+    log: fakeLog(log),
+  });
+  assert(executeCalls === 0, "dry-run never calls execute");
+  assert(result.dryRun === true && result.skipped.length === 1, "dry-run reports the entry as skipped");
+  assert(log.some((l) => l.includes("[DRY RUN]")), "dry-run logs its intended action");
+})();
+
+// --- runSafely: confirmation ----------------------------------------------
+
+(async function testConfirmationMismatch() {
+  const log = [];
+  let executeCalls = 0;
+  const result = await runSafely({
+    operationName: "DELETE",
+    entries: entries(["alpha"]),
+    allReposFile,
+    defaultOwner: "me",
+    destructive: true,
+    confirmPhrase: () => "DELETE 1 REPOS",
+    prompt: async () => "nope",
+    execute: async () => {
+      executeCalls++;
+    },
+    log: fakeLog(log),
+  });
+  assert(executeCalls === 0, "a wrong confirmation phrase never calls execute");
+  assert(result.aborted === "confirmation-mismatch", "a wrong confirmation phrase reports the correct abort reason");
+})();
+
+(async function testConfirmationMatch() {
+  const log = [];
+  let executeCalls = 0;
+  const result = await runSafely({
+    operationName: "DELETE",
+    entries: entries(["alpha"]),
+    allReposFile,
+    defaultOwner: "me",
+    destructive: true,
+    confirmPhrase: () => "DELETE 1 REPOS",
+    prompt: async () => "DELETE 1 REPOS",
+    execute: async () => {
+      executeCalls++;
+    },
+    log: fakeLog(log),
+  });
+  assert(executeCalls === 1, "the exact confirmation phrase lets execute run");
+  assert(result.succeeded.length === 1, "a matched confirmation reports success");
+})();
+
+// --- runSafely: full-wipe guard wired end-to-end ---------------------------
+
+(async function testFullWipeGuardEndToEnd() {
+  const log = [];
+  let executeCalls = 0;
+  const result = await runSafely({
+    operationName: "DELETE",
+    entries: entries(["alpha", "beta", "gamma"]),
+    allReposFile,
+    defaultOwner: "me",
+    destructive: true,
+    prompt: async () => "whatever", // must never even be reached
+    execute: async () => {
+      executeCalls++;
+    },
+    log: fakeLog(log),
+  });
+  assert(executeCalls === 0, "full-wipe guard blocks before confirmation is ever prompted");
+  assert(result.aborted === "full-wipe-guard", "full-wipe guard reports the correct abort reason");
+})();
+
+// --- runSafely: continue-on-error + summary ---------------------------------
+
+(async function testContinueOnErrorAndSummary() {
+  const log = [];
+  const result = await runSafely({
+    operationName: "ARCHIVE",
+    entries: entries(["alpha", "beta", "gamma"]),
+    destructive: false,
+    execute: async (entry) => {
+      if (entry.repo === "beta") throw new Error("boom");
+      return "ok";
+    },
+    log: fakeLog(log),
+  });
+  assert(result.succeeded.length === 2 && result.failed.length === 1, `one failure doesn't stop the rest (succeeded=${result.succeeded.length}, failed=${result.failed.length})`);
+  assert(result.failed[0].repo === "beta", "the failed entry names the right repo");
+  assert(log.some((l) => l.includes("2 succeeded, 1 failed")), "a real summary line is printed at the end");
+})();
+
+// --- runSafely: owner-repo mode wired end-to-end ----------------------------
+
+(async function testOwnerRepoModeEndToEnd() {
+  const log = [];
+  const calledWith = [];
+  const mixedEntries = parseEntries(["alpha", "someorg/shared-tool"], "me", true);
+  const result = await runSafely({
+    operationName: "ARCHIVE",
+    entries: mixedEntries,
+    allReposFile,
+    defaultOwner: "me",
+    destructive: false,
+    execute: async (entry) => {
+      calledWith.push(`${entry.owner}/${entry.repo}`);
+    },
+    log: fakeLog(log),
+  });
+  assert(result.succeeded.length === 2, "owner-repo mode: both a default-owner and an explicit-owner entry succeed");
+  assert(
+    calledWith.includes("me/alpha") && calledWith.includes("someorg/shared-tool"),
+    `execute receives the resolved owner for each entry (got ${JSON.stringify(calledWith)})`
+  );
+  assert(log.some((l) => l.includes("someorg/shared-tool")), "log lines use the owner/repo display form for a cross-owner entry");
+})();
+
+setTimeout(() => {
+  console.log(`\n${passed} passed, ${failed} failed`);
+  if (failed > 0) process.exit(1);
+}, 100);
